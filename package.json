{
  "name": "conduit-test-framework",
  "version": "1.0.0",
  "description": "Playwright test framework (UI + API) for the Conduit RealWorld demo app, built as a QA portfolio project.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium --project=ui-firefox --project=ui-webkit",
    "test:ui:chromium": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "playwright",
    "qa",
    "testing",
    "conduit",
    "realworld"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdrianMaresDev/Conduit-Test-Framework-POM.git"
  },
  "bugs": {
    "url": "https://github.com/AdrianMaresDev/Conduit-Test-Framework-POM/issues"
  },
  "homepage": "https://github.com/AdrianMaresDev/Conduit-Test-Framework-POM#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
